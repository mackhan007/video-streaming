# syntax=docker/dockerfile:1
# IMS processor image (FFmpeg + Kafka worker).
# Usage from repo root:
#   docker build -f backend/Dockerfile.ims -t ims-processor:latest backend

FROM rust:latest AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake g++ libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY . .
RUN --mount=type=cache,id=cargo-reg,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-git,target=/usr/local/cargo/git \
    --mount=type=cache,id=ims-target,target=/app/target \
    cargo build --release -p ims-processor \
    && cp /app/target/release/ims-processor /ims-processor

FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libssl3t64 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /ims-processor /usr/local/bin/ims-processor

ENV PROCESSOR_HTTP_PORT=8088
EXPOSE 8088
ENTRYPOINT ["/usr/local/bin/ims-processor"]
