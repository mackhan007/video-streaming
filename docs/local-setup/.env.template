AWS_PROFILE=localstack
AWS_CONFIG_FILE=docs/local-setup/config
AWS_SHARED_CREDENTIALS_FILE=docs/local-setup/credentials
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=videos

DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming

REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

CDN_BASE_URL=http://localhost:8081

# Logging (error / warn / info / debug / trace). Override freely.
# Examples: RUST_LOG=error | RUST_LOG=debug | RUST_LOG=ems_upload=trace,info
RUST_LOG=ems_server=debug,ems_upload=debug,ems_listing=debug,ems_streaming=debug,ims_processor=debug,tower_http=debug,info

# EMS unified server (upload + listing + streaming on one port)
EMS_HTTP_PORT=8080

# Standalone upload bin (only if running ems-upload alone)
HTTP_PORT=8085
S3_PUBLIC_ENDPOINT=http://localhost:4566
UPLOAD_PART_SIZE_BYTES=16777216
PRESIGN_TTL_SECS=3600
SESSION_TTL_SECS=86400
KAFKA_TOPIC=video.uploaded
