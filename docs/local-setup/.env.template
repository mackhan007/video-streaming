AWS_PROFILE=minio
AWS_CONFIG_FILE=docs/local-setup/config
AWS_SHARED_CREDENTIALS_FILE=docs/local-setup/credentials
AWS_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=videos

DATABASE_URL=postgres://streaming:streaming@localhost:5432/streaming
POSTGRES_USER=streaming
POSTGRES_PASSWORD=streaming
POSTGRES_DB=streaming

REDIS_URL=redis://localhost:6379
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092

CDN_BASE_URL=http://localhost:8081

# Logging (error / warn / info / debug / trace). Override freely.
# Examples: RUST_LOG=error | RUST_LOG=debug | RUST_LOG=ems_upload=trace,info
RUST_LOG=ems_server=debug,ems_upload=debug,ems_listing=debug,ems_streaming=debug,ims_processor=debug,tower_http=debug,info
# File logs (also stdout). Default set by export.sh to <repo>/logs
# LOG_DIR=/absolute/path/to/logs
# LOG_NAME=ems

# EMS unified server (upload + listing + streaming on one port)
EMS_HTTP_PORT=8080

# Standalone upload bin (only if running ems-upload alone)
HTTP_PORT=8085
S3_PUBLIC_ENDPOINT=http://localhost:9000
UPLOAD_PART_SIZE_BYTES=16777216
MAX_UPLOAD_BYTES=5368709120
MAX_TITLE_CHARS=200
ALLOWED_CONTENT_TYPES=video/mp4,video/webm,video/quicktime,video/x-matroska
PRESIGN_TTL_SECS=3600
SESSION_TTL_SECS=86400
WATCH_TTL_SECS=2592000
KAFKA_TOPIC=video.uploaded
KAFKA_GROUP_ID=ims-processor
# Parallel IMS processes (npm run dev). Kafka topic needs matching partitions.
IMS_WORKERS=3
PROCESSOR_HTTP_PORT=8088
HLS_SEGMENT_SECS=6
# Long-file encode: split timeline into chunks; N FFmpeg jobs at once (0 = CPU count).
# Packed ladder = one FFmpeg per chunk writes source-height rungs (k8s local: 60 / 2 / ultrafast).
IMS_CHUNK_SECS=60
IMS_ENCODE_PARALLEL=2
FFMPEG_PRESET=ultrafast
# ABR ladder rungs. 1080p implicitly requires 720p (disabling 720p drops
# 1080p too, regardless of this flag) — see backend/ims/processor ladder.rs.
IMS_ENABLE_720P=true
IMS_ENABLE_1080P=false
FFMPEG_PATH=ffmpeg
IMS_WORK_DIR=/tmp/ims-processor
